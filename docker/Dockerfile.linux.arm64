FROM harness0.harness.io/oci/docker_artifacts/hhi/go:1.26.10 AS hhi-go-toolchain-0
FROM harness0.harness.io/oci/docker_artifacts/hhi/harnessos-alpine:1 AS builder
COPY --from=hhi-go-toolchain-0 /usr/lib/go /usr/lib/go
ENV PATH=/usr/lib/go/bin:$PATH GOPATH=/go GOTOOLCHAIN=local
RUN apk add --update --no-cache 'ca-certificates>=20261020-r0' tzdata busybox-static && update-ca-certificates

FROM scratch AS runner

COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /bin/busybox /bin/sh

ADD release/linux/arm64/drone-cache /bin/
ENTRYPOINT ["/bin/drone-cache"]
