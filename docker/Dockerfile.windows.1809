# escape=`

FROM mcr.microsoft.com/windows/servercore:ltsc2019@sha256:7718cd7138fcb8f7ec594c7cfb1b429c99b50bad8be8cda21db369116cce5ed8 as core

FROM mcr.microsoft.com/windows/servercore:ltsc2019@sha256:7718cd7138fcb8f7ec594c7cfb1b429c99b50bad8be8cda21db369116cce5ed8 as roots
COPY docker/windows/ C:/roots-src/
RUN powershell -NoProfile -ExecutionPolicy Bypass -File C:\roots-src\export-roots.ps1


FROM mcr.microsoft.com/windows/nanoserver:1809@sha256:08d84cf1d9d6edd5f117bd955cc0e9d2a6db4b7f89d51c64518a7fe2372fb8d8
USER ContainerAdministrator
SHELL ["cmd", "/S", "/C"]

ENV GODEBUG=netdns=go
COPY --from=core /windows/system32/netapi32.dll /windows/system32/netapi32.dll
COPY --from=roots /roots/ /roots/
RUN for %f in (C:\roots\*.reg) do @(reg import "%f" || exit 1)

ADD release/windows/amd64/drone-cache.exe C:/drone-cache.exe
ENTRYPOINT [ "C:\\drone-cache.exe" ]